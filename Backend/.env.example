# ============================================
# GHOSTBUS BACKEND — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git
# ============================================

# ── Application ──────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (Supabase PostgreSQL) ───────────
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# ── JWT Authentication ────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_64_CHAR_HEX_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ── AWS S3 ────────────────────────────────────
# Region where your S3 bucket is created
AWS_REGION=ap-south-1

# IAM user credentials (use a dedicated IAM user — NOT root account)
# Permissions needed: s3:PutObject, s3:GetObject, s3:DeleteObject on your bucket only
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Single private bucket name (all files go here — audio, artwork, stems)
# Bucket must be: private (no public access), versioning ON, encryption AES256
AWS_S3_BUCKET=ghostbus-tracks-private

# ── Stripe ────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ── Frontend URL (CORS) ───────────────────────
FRONTEND_URL=http://localhost:5173

# ── Email (future — not needed now) ──────────
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@ghostbus.audio
